@* Навігація: Магазин продуктів - список продуктів, Категорії - список категорій *@
@* Щоб додати категорію: натисни "Категорії" -> "Додати категорію" *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div class="navbar">
        @Html.ActionLink("Магазин продуктів", "Index", "Products")
        @Html.ActionLink("Категорії", "Index", "Categories")
        @Html.ActionLink("Головна", "Index", "Home")
    </div>
    @RenderBody()
</body>
</html>