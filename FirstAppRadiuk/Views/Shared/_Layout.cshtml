@* Майстер-сторінка - спільний шаблон для всіх сторінок сайту *@
@* Містить: header, navbar, aside з новинами, footer *@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" type="text/css" />
</head>
<body>
    <div style="background-color:#1a252f; padding:5px; text-align:right;">
        @using (Html.BeginForm("ChangeCulture", "Products"))
        {
            <select name="lang" style="padding:3px;">
                <option disabled selected>@Resources.Resource.ChooseLang</option>
                <option value="uk">Українська</option>
                <option value="en">English</option>
            </select>
            <input type="submit" value="OK" style="padding:3px 8px;" />
        }
    </div>
    <header id="header">
        <h1>Продуктовий магазин</h1>
    </header>

    <nav id="nav">
        <ul>
            <li>@Html.ActionLink("Магазин продуктів", "Index", "Products")</li>
            <li>@Html.ActionLink("Категорії", "Index", "Categories")</li>
            <li>@Html.ActionLink("Головна", "Index", "Home")</li>
        </ul>
    </nav>

    <div id="main-wrapper">
        <aside id="side">
            <h2>Розділи</h2>
            <a href="/Products">Всі продукти</a>
            <a href="/Categories">Категорії</a>
            <a href="/Products/Create">Додати продукт</a>
            <a href="/Categories/Create">Додати категорію</a>
        </aside>

        <div id="con">
            @RenderBody()
        </div>
    </div>

    <footer id="footer">
        &copy; @DateTime.Now.Year - Продуктовий магазин Радюк Олександр
    </footer>
    <script src="@Url.Content("~/Scripts/jquery-3.3.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")"></script>
</body>
</html>