@model FirstAppRadiuk.Models.RegisterModel
@{
    ViewBag.Title = "Реєстрація";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Реєстрація</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div>
        @Html.ValidationSummary(false)
        <p>
            <label>Email</label>
            @Html.EditorFor(m => m.Email)
        </p>
        <p>
            <label>Рік народження</label>
            @Html.EditorFor(m => m.Year)
        </p>
        <p>
            <label>Пароль</label>
            @Html.EditorFor(m => m.Password)
        </p>
        <p>
            <label>Повторіть пароль</label>
            @Html.EditorFor(m => m.PasswordConfirm)
        </p>
        <p>
            <input class="btn-buy" type="submit" value="Зареєструватися" />
        </p>
    </div>
}