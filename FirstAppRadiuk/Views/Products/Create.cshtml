@model FirstAppRadiuk.Models.Product
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Додати продукт";
}
<div style="margin: 20px;">
    <h2>Додати продукт</h2>
    @using (Html.BeginForm())
    {
        <p>Назва: @Html.TextBoxFor(m => m.Name)</p>
        <p>Виробник: @Html.TextBoxFor(m => m.Manufacturer)</p>
        <p>Вага/Об'єм: @Html.TextBoxFor(m => m.Weight)</p>
        <p>Ціна: @Html.TextBoxFor(m => m.Price)</p>
        <p>К-сть на складі: @Html.TextBoxFor(m => m.Quantity)</p>
        <p>Категорія: @Html.DropDownListFor(m => m.CategoryId, ViewBag.Categories as SelectList, "-- Без категорії --")</p>
        <p><input type="submit" value="Зберегти" /></p>
    }
    <p><a href="/Products">Назад до списку</a></p>
</div>