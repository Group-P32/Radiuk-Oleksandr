@model FirstAppRadiuk.Models.Product
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Видалити продукт";
}
<div style="margin: 20px;">
    <h2>Видалити продукт?</h2>
    <p>Назва: @Model.Name</p>
    <p>Виробник: @Model.Manufacturer</p>
    <p>Ціна: @Model.Price грн</p>
    @using (Html.BeginForm())
    {
        <input type="submit" value="Підтвердити видалення" />
    }
    <p><a href="/Products">Скасувати</a></p>
</div>