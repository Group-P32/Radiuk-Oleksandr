@model FirstAppRadiuk.Models.ProductsListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Resource.ProductList;
}

<h2>@Resources.Resource.ProductList</h2>
<p style="margin: 15px 20px;"><a href="/Products/Create" class="btn-edit">@Resources.Resource.AddProduct</a></p>

<form method="get" style="margin: 0 20px 15px 20px;">
    <label>@Resources.Resource.Category:</label>
    @Html.DropDownList("category", Model.Categories as SelectList)
    &nbsp;
    <label>@Resources.Resource.Manufacturer:</label>
    @Html.DropDownList("manufacturer", Model.Manufacturers as SelectList)
    &nbsp;
    <input type="submit" value="Фільтр" />
</form>

<table border="1" cellpadding="5" cellspacing="0" style="width:100%; table-layout:fixed;">
    <colgroup>
        <col style="width:15%" />
        <col style="width:12%" />
        <col style="width:13%" />
        <col style="width:10%" />
        <col style="width:10%" />
        <col style="width:12%" />
        <col style="width:18%" />
    </colgroup>
    <tr>
        <th>@Resources.Resource.Name</th>
        <th>@Resources.Resource.Category</th>
        <th>@Resources.Resource.Manufacturer</th>
        <th>@Resources.Resource.Weight</th>
        <th>@Resources.Resource.Price</th>
        <th>@Resources.Resource.Quantity</th>
        <th>@Resources.Resource.Actions</th>
    </tr>
    @foreach (var item in Model.Products)
    {
        <tr>
            <td>@item.Name</td>
            <td>@(item.CategoryNav != null ? item.CategoryNav.Name : "—")</td>
            <td>@item.Manufacturer</td>
            <td>@item.Weight</td>
            <td>@item.Price</td>
            <td>@item.Quantity</td>
            <td>
                <div style="display:flex; flex-direction:column; gap:4px; width:90px;">
                    <a href="/Products/Edit/@item.Id" class="btn-edit">@Resources.Resource.Edit</a>
                    <a href="/Products/Buy/@item.Id" class="btn-buy">@Resources.Resource.Buy</a>
                    @using (Html.BeginForm("Delete", "Products", new { id = item.Id }, FormMethod.Post))
                    {
                        <input type="submit" value="@Resources.Resource.Delete" class="btn-delete" />
                    }
                </div>
            </td>
        </tr>
    }
</table>