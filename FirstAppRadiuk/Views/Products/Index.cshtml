@model FirstAppRadiuk.Models.ProductsListViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Магазин продуктів";
}

<h2>Список продуктів</h2>
<p style="margin: 15px 20px;"><a href="/Products/Create" class="btn-edit">Додати продукт</a></p>

<form method="get" style="margin: 0 20px 15px 20px;">
    <label>Категорія:</label>
    @Html.DropDownList("category", Model.Categories as SelectList)
    &nbsp;
    <label>Виробник:</label>
    @Html.DropDownList("manufacturer", Model.Manufacturers as SelectList)
    &nbsp;
    <input type="submit" value="Фільтр" />
</form>

<table border="1" cellpadding="5" cellspacing="0" style="width:100%; table-layout:fixed;">
    <colgroup>
        <col style="width:15%" />
        <col style="width:12%" />
        <col style="width:13%" />
        <col style="width:10%" />
        <col style="width:10%" />
        <col style="width:12%" />
        <col style="width:18%" />
    </colgroup>
    <tr>
        <th>Назва</th>
        <th>Категорія</th>
        <th>Виробник</th>
        <th>Вага/Об'єм</th>
        <th>Ціна (грн)</th>
        <th>К-сть на складі</th>
        <th>Дії</th>
    </tr>
    @foreach (var item in Model.Products)
    {
        <tr>
            <td>@item.Name</td>
            <td>@(item.CategoryNav != null ? item.CategoryNav.Name : "—")</td>
            <td>@item.Manufacturer</td>
            <td>@item.Weight</td>
            <td>@item.Price</td>
            <td>@item.Quantity</td>
            <td>
                <div style="display:flex; flex-direction:column; gap:4px; width:90px;">
                    <a href="/Products/Edit/@item.Id" class="btn-edit">Редагувати</a>
                    <a href="/Products/Buy/@item.Id" class="btn-buy">Купити</a>
                    @using (Html.BeginForm("Delete", "Products", new { id = item.Id }, FormMethod.Post))
                    {
                        <input type="submit" value="Видалити" class="btn-delete" />
                    }
                </div>
            </td>
        </tr>
    }
</table>